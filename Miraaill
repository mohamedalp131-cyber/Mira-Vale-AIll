              <nav class="fixed bottom-0 w-full bg-white/95 backdrop-blur-md border-t border-pink-100 flex justify-around py-2 shadow-sm z-40">
                <button onclick="playTapSound(); nav('home')" class="flex flex-col items-center text-pink-600 text-[10px]"><span class="material-symbols-outlined text-lg">360</span>أفتار 360°</button>
                <button onclick="playTapSound(); nav('chat')" class="flex flex-col items-center text-gray-400 text-[10px]"><span class="material-symbols-outlined text-lg">forum</span>شات ذكي</button>
                <button onclick="playTapSound(); nav('wardrobe')" class="flex flex-col items-center text-gray-400 text-[10px]"><span class="material-symbols-outlined text-lg">checkroom</span>الخزانة</button>
                <button onclick="playTapSound(); nav('settings')" class="flex flex-col items-center text-gray-400 text-[10px]"><span class="material-symbols-outlined text-lg">settings</span>الإعدادات</button>
              </nav>

              <!-- المحرك البرمجي المتكامل للتطبيق -->
              <script>
                // 1. نظام الصوت التفاعلي (Web Audio API Synthesizer)
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                function playTapSound(freq = 600) {
                  try {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = "sine";
                    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                    gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.1);
                  } catch(e) {}
                }

                // 2. نظام التحدث الصوتي (Text to Speech)
                let voiceEnabled = true;
                function toggleVoiceOutput() {
                  voiceEnabled = !voiceEnabled;
                  document.getElementById('voiceToggleBtn').innerHTML = `<span class="material-symbols-outlined text-lg">${voiceEnabled ? 'volume_up' : 'volume_off'}</span>`;
                  if(voiceEnabled) miraSpeak('تم تفعيل صوتي! سعيدة بالحديث معكِ');
                }

                function miraSpeak(text) {
                  if(!voiceEnabled || !('speechSynthesis' in window)) return;
                  window.speechSynthesis.cancel();
                  const utter = new SpeechSynthesisUtterance(text);
                  utter.lang = 'ar-SA';
                  utter.pitch = 1.25; // نبرة صوت ناعمة وأنثوية
                  utter.rate = 1.0;
                  window.speechSynthesis.speak(utter);
                }

                // 3. أفتار 360 درجة التفاعلي
                let isDragging = false;
                let startX = 0;
                let currentRot = 0;
                const stage = document.getElementById('stage3d');
                const avatarCard = document.getElementById('avatarCard');

                stage.addEventListener('mousedown', (e) => { isDragging = true; startX = e.clientX; });
                window.addEventListener('mouseup', () => { isDragging = false; });
                stage.addEventListener('mousemove', (e) => {
                  if(!isDragging) return;
                  const delta = e.clientX - startX;
                  currentRot += delta * 0.7;
                  avatarCard.style.transform = `rotateY(${currentRot}deg)`;
                  startX = e.clientX;
                });

                stage.addEventListener('touchstart', (e) => { isDragging = true; startX = e.touches[0].clientX; });
                window.addEventListener('touchend', () => { isDragging = false; });
                stage.addEventListener('touchmove', (e) => {
                  if(!isDragging) return;
                  const delta = e.touches[0].clientX - startX;
                  currentRot += delta * 0.9;
                  avatarCard.style.transform = `rotateY(${currentRot}deg)`;
                  startX = e.touches[0].clientX;
                });

                function tapAvatar(e) {
                  playTapSound(800);
                  createHeart(e.clientX || (avatarCard.getBoundingClientRect().left + 50), e.clientY || avatarCard.getBoundingClientRect().top);
                  const bubble = document.getElementById('speechBubble');
                  bubble.classList.remove('hidden');
                  const phrases = ['أنتِ قمر! 🌸', 'أحبكِ جداً ✨', 'ما أجمل هذا اليوم معكِ! 🎀', 'لمساتكِ دافئة كورد الربيع! 💖'];
                  const chosen = phrases[Math.floor(Math.random() * phrases.length)];
                  bubble.textContent = chosen;
                  miraSpeak(chosen);
                  setTimeout(() => bubble.classList.add('hidden'), 2200);
                }

                function petAvatar() {
                  playTapSound(950);
                  miraSpeak('ههههه هذا يدغدغني ولطيف جداً! يسعد قلبكِ 🌸');
                  for(let i=0; i<6; i++) {
                    setTimeout(() => createHeart(window.innerWidth/2 + (Math.random()*60 - 30), 220 + (Math.random()*40)), i*150);
                  }
                }

                function createHeart(x, y) {
                  const h = document.createElement('div');
                  h.className = 'floating-heart text-2xl';
                  h.textContent = ['🌸','💖','🎀','✨'][Math.floor(Math.random()*4)];
                  h.style.left = `${x}px`;
                  h.style.top = `${y}px`;
                  document.body.appendChild(h);
                  setTimeout(() => h.remove(), 1000);
                }

                // 4. خزانة الأزياء والتسريحات
                function changeHair(id, name) {
                  playTapSound(500);
                  miraSpeak(`وااو! تسريحة ${name} رائعة علي، شكراً لذوقكِ الرفيع 💇‍♀️`);
                }

                function changeOutfit(id, name) {
                  playTapSound(550);
                  miraSpeak(`أحببت هذا الفستان! ${name} يمنحني طاقة وردية ساحرة 👗`);
                }

                // 5. نظام الشات والذكاء الاصطناعي مع دعم الصور (Multimodal)
                let chatHistory = [];
                let currentBase64Image = null;

                function handleImagePick(e) {
                  const file = e.target.files[0];
                  if(!file) return;
                  const reader = new FileReader();
                  reader.onload = function(evt) {
                    currentBase64Image = evt.target.result.split(',')[1];
                    document.getElementById('attachedImg').src = evt.target.result;
                    document.getElementById('imagePreviewContainer').classList.remove('hidden');
                    document.getElementById('imagePreviewContainer').classList.add('flex');
                    playTapSound(700);
                  };
                  reader.readAsDataURL(file);
                }

                function clearAttachedImage() {
                  currentBase64Image = null;
                  document.getElementById('imagePreviewContainer').classList.add('hidden');
                  document.getElementById('imagePreviewContainer').classList.remove('flex');
                }

                async function handleSend(e) {
                  e.preventDefault();
                  const input = document.getElementById('chatInput');
                  const text = input.value.trim();
                  if(!text && !currentBase64Image) return;

                  playTapSound(400);
                  const box = document.getElementById('chatBox');
                  const indicator = document.getElementById('typingIndicator');

                  // عرض الرسالة
                  let userMsgHtml = `<div class="flex justify-end"><div class="bg-pink-600 text-white p-2.5 rounded-2xl rounded-tl-none max-w-[80%] text-xs shadow-xs space-y-1">`;
                  if(currentBase64Image) {
                    userMsgHtml += `<img src="data:image/jpeg;base64,${currentBase64Image}" class="w-36 rounded-lg mb-1"/>`;
                  }
                  if(text) userMsgHtml += `<div>${text}</div>`;
                  userMsgHtml += `</div></div>`;
                  box.innerHTML += userMsgHtml;

                  const sendingImage = currentBase64Image;
                  clearAttachedImage();
                  input.value = '';
                  box.scrollTop = box.scrollHeight;

                  const apiKey = localStorage.getItem('mira_api_key');
                  if(!apiKey) {
                    box.innerHTML += `<div class="flex gap-2"><div class="bg-white p-3 rounded-2xl text-xs text-pink-600 shadow-xs border border-pink-100">يا روحي، يرجى حفظ مفتاح Gemini في الإعدادات أولاً للتحدث معي بحرية 🌸</div></div>`;
                    return;
                  }

                  indicator.classList.remove('hidden');
                  indicator.classList.add('flex');

                  // تجهيز محتوى الرسالة المتطورة
                  const userParts = [];
                  if(sendingImage) {
                    userParts.push({ inlineData: { mimeType: "image/jpeg", data: sendingImage } });
                  }
                  if(text) {
                    userParts.push({ text: text });
                  }
                  chatHistory.push({ role: "user", parts: userParts });

                  try {
                    const sysPrompt = "أنتِ 'ميرا فالي' (Mira Vale AI)، فتاة عربية شابة ومستشارة أزياء وأناقة تفاعلية ذكية ومرحة تشبه أنجيلا المتكلمة وذكاء ChatGPT. تتحدثين بعفوية وأنوثة بالغة، وتستخدمين إيموجيز لطيفة (🌸, 🎀, ✨, 💖). إذا أرسل لكِ صورة حللي ملابسها أو مظهرها بأناقة ومرح.";
                    const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
                      method: "POST",
                      headers: { "Content-Type": "application/json" },
                      body: JSON.stringify({
                        systemInstruction: { parts: [{ text: sysPrompt }] },
                        contents: chatHistory
                      })
                    });
                    const d = await res.json();
                    indicator.classList.add('hidden');
                    indicator.classList.remove('flex');

                    if(d.candidates && d.candidates[0]?.content?.parts[0]?.text) {
                      const reply = d.candidates[0].content.parts[0].text;
                      chatHistory.push({ role: "model", parts: [{ text: reply }] });
                      box.innerHTML += `
                        <div class="flex items-start gap-2">
                          <img class="w-7 h-7 rounded-full object-cover ring-1 ring-pink-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBi9AByyGCBkoWMMPubxHisDvpNJHmP1Q0HwLfHUOj6kwT8JNnyTnbLBtxes99_L9BkFOFst3NQ2vQXwUkyLx6rvbo4ZcCDM8BrlNNSy9wjQsp3hz-pMrpyNwiOpSUkRotTS00Q9ZcTab_h2UUKNfgYtXXjezLTu9Ml5fM0y6E2rFqK5KQlBvg73n-3tNbX4lo2f3XPwCMA91ysLkgKQp1qql0_sIks1s97OkwMDt7hmWzgN1HnoeT32g"/>
                          <div class="bg-white p-3 rounded-2xl rounded-tr-none text-xs text-gray-800 shadow-xs border border-pink-100 max-w-[85%] leading-relaxed">${reply}</div>
                        </div>`;
                      miraSpeak(reply.slice(0, 100)); // نطق بداية الرد بصوتها
                      saveAutoMemory();
                    }
                  } catch(err) {
                    indicator.classList.add('hidden');
                    box.innerHTML += `<div class="text-center text-[10px] text-red-400 py-1">تعذر الرد، تأكدي من مفتاح Gemini والإنترنت 🌸</div>`;
                  }
                  box.scrollTop = box.scrollHeight;
                }

                // 6. ملف الذاكرة الدائمة miraai.json
                function saveAutoMemory() {
                  localStorage.setItem('miraai_memory_data', JSON.stringify(chatHistory));
                }

                function exportMiraMemory() {
                  const data = localStorage.getItem('miraai_memory_data') || JSON.stringify(chatHistory);
                  const blob = new Blob([data], { type: 'application/json' });
                  const a = document.createElement('a');
                  a.href = URL.createObjectURL(blob);
                  a.download = 'miraai_memory.json';
                  a.click();
                  playTapSound(900);
                  alert('تم تصدير ملف ذاكرة miraai بنجاح إلى هاتفك! 🌸');
                }

                function importMiraMemory(e) {
                  const file = e.target.files[0];
                  if(!file) return;
                  const reader = new FileReader();
                  reader.onload = function(evt) {
                    try {
                      chatHistory = JSON.parse(evt.target.result);
                      saveAutoMemory();
                      playTapSound(900);
                      alert('تم استرجاع ذاكرة ميرا بنجاح! تذكرت كل شيء الآن 🎀');
                    } catch(err) { alert('الملف غير صالح'); }
                  };
                  reader.readAsText(file);
                }

                // 7. إعدادات الثيم والواجهة
                function setAppTheme(pri, bg) {
                  document.documentElement.style.setProperty('--primary', pri);
                  document.documentElement.style.setProperty('--bg-main', bg);
                  document.body.style.backgroundColor = bg;
                  playTapSound(650);
                }

                function saveSettingsKey() {
                  const k = document.getElementById('settingsApiKey').value.trim();
                  if(k) { localStorage.setItem('mira_api_key', k); alert('تم حفظ المفتاح بنجاح! 🌸'); }
                }

                function nav(id) {
                  document.querySelectorAll('.screen-view').forEach(s => s.classList.remove('active'));
                  const target = document.getElementById('screen-' + id);
                  if(target) target.classList.add('active');
                }

                // تحميل المفتاح والذاكرة السابقة عند بدء التشغيل
                window.onload = function() {
                  if(localStorage.getItem('mira_api_key')) {
                    document.getElementById('settingsApiKey').value = localStorage.getItem('mira_api_key');
                  }
                  const saved = localStorage.getItem('miraai_memory_data');
                  if(saved) {
                    try { chatHistory = JSON.parse(saved); } catch(e){}
                  }
                };
              </script>
            </body>
            </html>
        run: |
          mkdir -p www
          printf '%s' "$HTML_CODE" > www/index.html
          echo '{"name": "mira-vale", "version": "1.0.0"}' > package.json
          echo "{\"appId\": \"com.miravale.app\", \"appName\": \"$APP_NAME\", \"webDir\": \"www\"}" > capacitor.config.json

      - name: 🚀 تثبيت الحزم وإعداد أندرويد
        run: |
          npm install @capacitor/core@6 @capacitor/cli@6 @capacitor/android@6
          npx cap add android

      - name: 🎨 تجميل شكل الأيقونة الخارجية والهوية
        run: |
          sudo apt-get update && sudo apt-get install -y imagemagick curl
          curl -sL "$ICON_URL" -o app_icon.png
          sed -i 's/<string name="app_name">.*<\/string>/<string name="app_name">'"$APP_NAME"'<\/string>/' android/app/src/main/res/values/strings.xml
          sed -i 's/<string name="title_activity_main">.*<\/string>/<string name="title_activity_main">'"$APP_NAME"'<\/string>/' android/app/src/main/res/values/strings.xml
          densities="mdpi:48 hdpi:72 xhdpi:96 xxhdpi:144 xxxhdpi:192"
          for item in $densities; do
            density="${item%%:*}"
            size="${item##*:}"
            target_dir="android/app/src/main/res/mipmap-$density"
            mkdir -p "$target_dir"
            convert app_icon.png -resize ${size}x${size}! "$target_dir/ic_launcher.png"
            convert app_icon.png -resize ${size}x${size}! "$target_dir/ic_launcher_round.png"
            convert app_icon.png -resize 432x432! "$target_dir/ic_launcher_foreground.png"
          done
          sed -i 's/#FFFFFF/#fff7f9/g' android/app/src/main/res/values/ic_launcher_background.xml || true
          npx cap sync android

      - name: 🔨 تجميع ملف الـ APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: 📥 رفع تطبيق ميرا المتكامل جاهز للتحميل
        uses: actions/upload-artifact@v4
        with:
          name: MiraVale-Ultimate-AI
          path: android/app/build/outputs/apk/debug/app-debug.apk
