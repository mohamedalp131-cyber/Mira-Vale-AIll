                body {
                  font-family: 'Noto Sans Arabic', sans-serif;
                  background-color: var(--bg-main);
                  user-select: none;
                  -webkit-tap-highlight-color: transparent;
                }
                .screen-view { display: none; }
                .screen-view.active { display: flex; }
                .avatar-3d-stage {
                  perspective: 1000px;
                  touch-action: pan-y;
                }
                .avatar-3d-card {
                  transition: transform 0.1s ease-out;
                  transform-style: preserve-3d;
                }
                @keyframes floatHeart {
                  0% { opacity: 1; transform: translateY(0) scale(0.8); }
                  100% { opacity: 0; transform: translateY(-70px) scale(1.4); }
                }
                .floating-heart {
                  position: absolute;
                  animation: floatHeart 1s forwards ease-out;
                  pointer-events: none;
                }
              </style>
            </head>
            <body class="min-h-screen flex flex-col justify-between text-gray-800">

