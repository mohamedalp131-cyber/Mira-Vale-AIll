                      <img id="avatarOutfit" class="absolute inset-0 w-full h-full object-contain z-20 pointer-events-none" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDi2Co-WmSIbqM0JIpeHXzWcJCIi91rf50TM5jL9TqZ6o6yYSGzzvylFW3HpKsYxBN6kF-4B3Yim73Z09ex6ELHUqAyzKJRdgRyODr2ikfug8qlv6XBoURUMsyXCcrVZo00FsKJBx8GrYi9b48PqgOgqLLiGnJGHBFuvT7zb-hP3rVQ-srVb3ojJnBB6agOqejBJW92GmdmK1souTKNEDBpl3ogsVjkcQLLBRakvpjc"/>
                      <span id="speechBubble" class="hidden absolute -top-8 bg-white border border-pink-300 text-pink-700 font-bold px-3 py-1 rounded-2xl text-[11px] shadow-md z-30 animate-bounce">
