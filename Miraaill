                  </div>
                </div>

                <div class="flex items-center gap-1.5">
                  <button onclick="toggleVoiceOutput()" id="voiceToggleBtn" class="w-8 h-8 rounded-full bg-pink-50 flex items-center justify-center text-pink-600 border border-pink-200">
