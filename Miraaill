name: Build Mira Vale Ultimate AI

on:
  push:
    branches: ["**"]
  workflow_dispatch:

env:
  APP_NAME: "ميرا AI المتكلمة 🎀"
  ICON_URL: "https://lh3.googleusercontent.com/aida-public/AB6AXuBi9AByyGCBkoWMMPubxHisDvpNJHmP1Q0HwLfHUOj6kwT8JNnyTnbLBtxes99_L9BkFOFst3NQ2vQXwUkyLx6rvbo4ZcCDM8BrlNNSy9wjQsp3hz-pMrpyNwiOpSUkRotTS00Q9ZcTab_h2UUKNfgYtXXjezLTu9Ml5fM0y6E2rFqK5KQlBvg73n-3tNbX4lo2f3XPwCMA91ysLkgKQp1qql0_sIks1s97OkwMDt7hmWzgN1HnoeT32g"

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: ⚙️ إعداد Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: ☕ إعداد Java JDK
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: 📦 بناء نظام وتطبيق ميرا فالي المتكامل
        env:
          HTML_CODE: |
            <!DOCTYPE html>
            <html dir="rtl" lang="ar">
            <head>
              <meta charset="utf-8"/>
              <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" name="viewport"/>
              <meta name="theme-color" content="#ac2471"/>
              <title>Mira Vale AI - ميرا فالي</title>
              <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
              <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
