                  <div class="flex items-center justify-between">
                    <div>
                      <h3 class="font-bold text-sm text-pink-700">خزانة وتزيين ميرا 👗</h3>
                      <p class="text-[10px] text-gray-500">اختاري التسريحة والملابس لتتغير على الأفتار فوراً!</p>
                    </div>
                    <button onclick="nav('home')" class="text-xs bg-pink-50 text-pink-600 px-3 py-1 rounded-full border border-pink-200">عرض في 360°</button>
                  </div>

                  <!-- تبويبات الخزانة -->
                  <div class="space-y-2">
                    <span class="text-xs font-bold text-gray-700 block">💇‍♀️ تسريحات الشعر:</span>
                    <div class="grid grid-cols-3 gap-2">
                      <button onclick="changeHair('hair1', 'كيرلي وردي كواي')" class="p-2 rounded-2xl bg-white border border-pink-200 text-center active:scale-95 transition-transform shadow-xs">
