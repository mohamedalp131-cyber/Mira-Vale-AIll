                        <span>💖</span> دغدغة وملاطفة
                      </button>
                      <button onclick="miraSpeak('أهلاً بكِ في عالمي الساحر! ما رأيك في إطلالتي اليوم؟')" class="px-3 py-1 rounded-full bg-white/90 text-pink-600 shadow-sm border border-pink-100 text-[10px] font-bold flex items-center gap-1 active:scale-90 transition-transform">
                        <span>🎙️</span> اجعليها تتحدث
                      </button>
                    </div>
                  </div>

                  <!-- كروت الوظائف السريعة -->
                  <div class="grid grid-cols-2 gap-2.5">
                    <div onclick="nav('chat')" class="p-4 rounded-2xl bg-white shadow-xs border border-pink-100 flex flex-col justify-between cursor-pointer active:scale-98 transition-transform">
                      <div class="w-8 h-8 rounded-full bg-pink-100 text-pink-600 flex items-center justify-center mb-1">
                        <span class="material-symbols-outlined text-lg">forum</span>
                      </div>
                      <span class="text-xs font-bold">محادثة ذكية وحرة</span>
                      <span class="text-[10px] text-gray-500">تدعم الصور وسياق الكلام</span>
                    </div>

                    <div onclick="nav('wardrobe')" class="p-4 rounded-2xl bg-white shadow-xs border border-pink-100 flex flex-col justify-between cursor-pointer active:scale-98 transition-transform">
                      <div class="w-8 h-8 rounded-full bg-pink-100 text-pink-600 flex items-center justify-center mb-1">
                        <span class="material-symbols-outlined text-lg">checkroom</span>
                      </div>
                      <span class="text-xs font-bold">خزانة وتغيير الملابس</span>
                      <span class="text-[10px] text-gray-500">أزياء وتسريحات متنوعة</span>
                    </div>
                  </div>
                </section>

                <!-- 2. المحادثة الذكية المتقدمة مع دعم إرسال الصور (ChatGPT Style) -->
