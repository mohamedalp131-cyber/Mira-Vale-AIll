                      </div>
                      <div onclick="changeOutfit('outfit3', 'إطلالة مسائية فاخرة')" class="p-2.5 rounded-2xl bg-white border border-pink-200 cursor-pointer shadow-xs active:scale-95 transition-transform text-center">
                        <img class="h-28 w-full object-cover rounded-xl" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBQIzm5uogqmlVBCU76Bi5Y9PXO7cfrYbFXkjO9DXbB-fN_1hCZk4NixkmhBO9xvFTUk3mFVnF3FYYG6NC7X9R3Ozpj_dMtV4WD9UMfzsDMSv9oGSy17uvJWP3LOwzt00CxAf2XMoSbTMM9PL0-o9JdtpRc0xoMKpY1dnstBfJyweReE2RtVYnpcBCg2QwIc46iiyPf3D9Jm-eCGKLwalFZMMfKajWwh_g06UnNAEAd"/>
                        <span class="text-[11px] font-bold mt-1.5 block text-pink-700">إطلالة مسائية ساحرة</span>
