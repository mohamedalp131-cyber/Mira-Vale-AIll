                    </button>
                    <input id="chatInput" type="text" placeholder="اكتبي لميرا أو اسأليها عن أي شيء..." class="flex-1 px-4 py-2.5 rounded-full bg-white border border-pink-200 text-xs focus:outline-none focus:ring-1 focus:ring-pink-500 shadow-xs"/>
