                      </div>
                    </div>
                  </div>

                  <!-- معاينة الصورة المرفقة قبل الإرسال -->
                  <div id="imagePreviewContainer" class="hidden relative p-2 bg-pink-50 rounded-2xl border border-pink-200 mb-1 items-center gap-2">
